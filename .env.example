# =============================================================================
# Desenvolvimento local (fora do Docker). Copie para .env e ajuste.
# Para carregar no shell:  set -a && source .env && set +a
# =============================================================================
DJANGO_ENV=development
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=troque-por-uma-chave-local
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://lacrei:lacrei@localhost:5432/lacrei
CORS_ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# Asaas (mock por padrão; para o sandbox real defina ASAAS_MOCK=false e a chave)
ASAAS_MOCK=true
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=troque-por-um-token-aleatorio
ASAAS_PERCENTUAL_PROFISSIONAL=90
