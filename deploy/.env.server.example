# =============================================================================
# .env do SERVIDOR (um por ambiente):
#   /opt/lacrei/staging/.env  e  /opt/lacrei/production/.env
# Nunca versione o arquivo real. Gere segredos com:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
# Comentários sempre em linha própria (não use "# ..." ao lado de valores).
# =============================================================================

# --- Django ---
# Use "staging" no ambiente de staging.
DJANGO_ENV=production
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=GERAR-UM-SEGREDO-LONGO
DJANGO_ALLOWED_HOSTS=api.seudominio.com.br
CSRF_TRUSTED_ORIGINS=https://api.seudominio.com.br
CORS_ALLOWED_ORIGINS=https://app.seudominio.com.br
# Se estiver testando só por HTTP/IP: SSL_REDIRECT=false e HSTS_SECONDS=0.
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_COOKIES=true
LOG_LEVEL=INFO
GUNICORN_WORKERS=3

# --- Banco (container postgres do compose) ---
POSTGRES_DB=lacrei
POSTGRES_USER=lacrei
POSTGRES_PASSWORD=GERAR-UMA-SENHA-FORTE
DATABASE_URL=postgres://lacrei:GERAR-UMA-SENHA-FORTE@db:5432/lacrei

# --- Proxy reverso (Caddy) ---
# Domínio => HTTPS automático. Para acessar pelo IP sem HTTPS use :80
SITE_ADDRESS=api.seudominio.com.br
HTTP_PORT=80
HTTPS_PORT=443

# --- Asaas ---
# staging: ASAAS_MOCK=true (ou sandbox real) | produção: false + chave de produção
ASAAS_MOCK=true
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=GERAR-UM-TOKEN
ASAAS_PERCENTUAL_PROFISSIONAL=90
